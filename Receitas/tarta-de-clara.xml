    <ingrediente>2 tarros de Philadelpia 250g</ingrediente>
    <ingrediente>2 sobres de xelatina de limón</ingrediente>
    <ingrediente>240g de chocolate de fundir</ingrediente>
    <ingrediente>100g de mantequilla</ingrediente>
    <ingrediente>150g de fariña</ingrediente>
