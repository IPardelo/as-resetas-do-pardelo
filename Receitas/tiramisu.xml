<receta creada="2026-09-27T14:05:51" modificada="2026-09-27T14:25:06">
  <titulo>Tiramisú</titulo>
  <categoria>postre</categoria>
  <ingredientes>
    <ingrediente>2 ovos</ingrediente>
    <ingrediente>1 tarrina de queixo mascarpone 250g</ingrediente>
    <ingrediente>2 cucharadas soperas de azucre</ingrediente>
    <ingrediente>Bizcochos de soletilla</ingrediente>
    <ingrediente>1 vaso de café</ingrediente>
  </ingredientes>
  <pasos>
    <paso>Mollar os bizcochos en café</paso>
    <paso>Batir as claras a punto de neve</paso>
    <paso>Batir as xemas co azucar e o mascarpone</paso>
    <paso>Engadir as claras a esa mezcla</paso>
    <paso>Montar a tarta facendo capas cos bizcochos e a crema</paso>
    <paso>Espolvorear o cacao en polvo por encima</paso>
  </pasos>
</receta>